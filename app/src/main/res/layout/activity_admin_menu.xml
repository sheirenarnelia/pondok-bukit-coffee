
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/brand_cream_bg">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackMenu"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Back"
        android:textAllCaps="false"
        android:textColor="@color/brand_espresso"
        app:strokeColor="@color/brand_border"
        app:cornerRadius="14dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Manage Menu"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/brand_espresso"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Add, edit and delete menu items."
        android:textSize="15sp"
        android:textColor="@color/brand_roast"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddMenu"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"
        android:text="+ Add New Menu"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="@color/brand_terracotta"
        app:cornerRadius="14dp"/>

    <TextView
        android:id="@+id/tvEmptyMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Loading menu..."
        android:textColor="@color/brand_roast"
        android:textSize="15sp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminMenu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"/>

</LinearLayout>
