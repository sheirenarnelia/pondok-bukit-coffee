<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_cream_bg"
    android:paddingHorizontal="28dp"
    android:paddingTop="20dp"
    android:paddingBottom="24dp"
    tools:context=".MainActivity">

    <!-- Top Luxury Kicker Badge -->
    <TextView
        android:id="@+id/tvWelcomeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_chip_terracotta"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        android:letterSpacing="0.14"
        android:text="ARTISANAL COFFEE HOUSE"
        android:textColor="@color/brand_terracotta"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center Content Block (Logo + Headlines + Subtitle + Chips) -->
    <LinearLayout
        android:id="@+id/llCenterContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/llButtonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvWelcomeBadge">

        <!-- High-Definition Seamless Logo -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_pondokbukit" />

        <!-- Luxury Editorial Tagline Title (Centered) -->
        <TextView
            android:id="@+id/tvHeroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/playfair_display_bold"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:lineSpacingExtra="4dp"
            android:text="Your Cozy Corner\nfor Coffee Moments"
            android:textColor="@color/brand_espresso"
            android:textSize="30sp" />

        <!-- Refined Warm Subtitle (Centered) -->
        <TextView
            android:id="@+id/tvHeroSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Fresh mountain air, peaceful hillside vibes, and handcrafted brews made for your perfect pause."
            android:textColor="@color/brand_roast"
            android:textSize="13.5sp" />

        <!-- Aesthetic Highlight Pills (Centered) -->
        <LinearLayout
            android:id="@+id/llFeatureChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_terracotta"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:letterSpacing="0.02"
                android:text="Hill View"
                android:textColor="@color/brand_terracotta"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_terracotta"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:letterSpacing="0.02"
                android:text="Artisanal Brews"
                android:textColor="@color/brand_terracotta"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_terracotta"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:letterSpacing="0.02"
                android:text="Cozy Saung"
                android:textColor="@color/brand_terracotta"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Buttons Container -->
    <LinearLayout
        android:id="@+id/llButtonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Primary Sign In Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:elevation="2dp"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:letterSpacing="0.04"
            android:text="@string/btn_login"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/brand_terracotta"
            app:cornerRadius="18dp" />

        <!-- Secondary Create Account Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/brand_surface"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:letterSpacing="0.04"
            android:text="@string/btn_register"
            android:textAllCaps="false"
            android:textColor="@color/brand_espresso"
            android:textSize="16sp"
            app:cornerRadius="18dp"
            app:strokeColor="@color/brand_border"
            app:strokeWidth="1.5dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
